# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Your public hostname first; localhost entries are needed for the container healthcheck.
DJANGO_ALLOWED_HOSTS=learn.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://learn.example.com
# Used to build students' personal MCP URLs and invite links.
PUBLIC_BASE_URL=https://learn.example.com
# Secure cookies require HTTPS. Set false only for plain-http local testing.
DJANGO_SECURE_COOKIES=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=learnmcp
POSTGRES_USER=learnmcp
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- HTTPS (Caddy)
# "https" starts Caddy with automatic Let's Encrypt certificates for DOMAIN.
# Leave empty when running behind your own proxy / tunnel, or locally.
COMPOSE_PROFILES=https
DOMAIN=learn.example.com

# ---------------------------------------------------------------- Web process
WEB_BIND=127.0.0.1
WEB_PORT=8000
WEB_CONCURRENCY=2
# Requests per minute per student token (per worker process).
MCP_RATE_LIMIT_PER_MINUTE=60
# Optional DNS-rebinding protection for the MCP endpoint, e.g. learn.example.com
MCP_ALLOWED_HOSTS=
INACTIVE_AFTER_DAYS=7

# ---------------------------------------------------------------- Operator account (optional, created once)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
